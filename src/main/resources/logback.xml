<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging replaces the legacy die("Error: " . $e->getMessage()) pattern, which
  killed the request, showed raw SQL to whoever was standing at the counter,
  and left the write half-done.

  The file location comes from the offlinepos.logdir system property, which
  Launcher sets before the first logger is created.
-->
<configuration>

    <property name="LOG_DIR" value="${offlinepos.logdir:-logs}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{28} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/offlinepos.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/offlinepos.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <!-- A shop that calls about "last Tuesday" needs the log to still be there. -->
            <maxHistory>60</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>

        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{40} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="lk.com.synsoft.offlinepos" level="DEBUG"/>

    <!-- Hikari says a lot at INFO on every pool event. WARN is enough in the field. -->
    <logger name="com.zaxxer.hikari" level="WARN"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>
