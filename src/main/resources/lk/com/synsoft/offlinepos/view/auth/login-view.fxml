<?xml version="1.0" encoding="UTF-8"?>

<!-- Ported from the reference app's LoginPage.jsx. -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="form" spacing="14"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="lk.com.synsoft.offlinepos.controller.LoginController">

    <Label text="Sign in" styleClass="form-heading"/>

    <!-- One message for every kind of refusal. It never says which of the
         name and the password was wrong: a till sits on a shop counter. -->
    <Label fx:id="errorLabel" styleClass="form-error" wrapText="true"
           visible="false" managed="false"/>

    <VBox styleClass="field" spacing="4">
        <Label text="User name" styleClass="field-label"/>
        <TextField fx:id="userNameField" promptText="Your user name"/>
    </VBox>

    <VBox styleClass="field" spacing="4">
        <Label text="Password" styleClass="field-label"/>
        <PasswordField fx:id="passwordField" promptText="Your password"/>
    </VBox>

    <Button fx:id="signInButton" text="Sign in" styleClass="button-primary"
            maxWidth="Infinity" defaultButton="true" onAction="#onSignIn"/>

    <HBox alignment="CENTER">
        <Hyperlink text="Forgotten your password?" onAction="#onForgotPassword"/>
    </HBox>

</VBox>
