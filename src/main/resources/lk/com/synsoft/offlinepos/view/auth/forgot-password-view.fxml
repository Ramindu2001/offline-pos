<?xml version="1.0" encoding="UTF-8"?>

<!--
  The reference app emails a reset link. A standalone till has no mail server
  and nothing to send from, so this screen tells the user what actually has to
  happen instead: an administrator sets a new password from the Users screen.
-->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="form" spacing="14"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="lk.com.synsoft.offlinepos.controller.ForgotPasswordController">

    <Label text="Forgotten your password?" styleClass="form-heading"/>

    <Label styleClass="form-note" wrapText="true"
           text="This till is not connected to anything, so it cannot email you a reset link."/>

    <Label styleClass="form-note" wrapText="true"
           text="Ask an administrator to set a new password for you from Master Data, Users. You can change it yourself once you are signed in."/>

    <Button text="Back to sign in" styleClass="button-primary"
            maxWidth="Infinity" defaultButton="true" onAction="#onBack"/>

</VBox>
