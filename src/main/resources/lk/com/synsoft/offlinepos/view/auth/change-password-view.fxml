<?xml version="1.0" encoding="UTF-8"?>

<!-- Ported from ChangePasswordPage.jsx. -->

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page" spacing="14" maxWidth="440"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="lk.com.synsoft.offlinepos.controller.ChangePasswordController">

    <Label text="Change your password" styleClass="page-heading"/>

    <Label fx:id="messageLabel" wrapText="true" visible="false" managed="false"/>

    <VBox styleClass="field" spacing="4">
        <Label text="Current password" styleClass="field-label"/>
        <PasswordField fx:id="currentField"/>
    </VBox>

    <VBox styleClass="field" spacing="4">
        <Label text="New password" styleClass="field-label"/>
        <PasswordField fx:id="newField"/>
        <Label text="At least 6 characters." styleClass="field-hint"/>
    </VBox>

    <VBox styleClass="field" spacing="4">
        <Label text="New password again" styleClass="field-label"/>
        <PasswordField fx:id="repeatField"/>
    </VBox>

    <HBox spacing="10">
        <Button fx:id="saveButton" text="Change password" styleClass="button-primary"
                defaultButton="true" onAction="#onSave"/>
        <Button text="Cancel" styleClass="button-secondary" onAction="#onCancel"/>
    </HBox>

</VBox>
